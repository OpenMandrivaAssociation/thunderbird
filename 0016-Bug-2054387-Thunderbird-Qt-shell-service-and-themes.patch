+#ifndef COMM_MAIL_COMPONENTS_SHELL_NSQTSHELLSERVICE_H_
+#define COMM_MAIL_COMPONENTS_SHELL_NSQTSHELLSERVICE_H_
+
+#include "nsIShellService.h"
+#include "nsString.h"
+#include "nsToolkitShellService.h"
+#include "nsTArray.h"
+
+/**
+ * Linux/Qt shell service for Thunderbird: FreeDesktop default client
+ * registration via xdg-settings / xdg-mime (no GIO/GTK).
+ */
+class nsQtShellService final : public nsIShellService,
+                               public nsToolkitShellService {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_NSISHELLSERVICE
+
+  nsresult Init();
+  nsQtShellService() = default;
+
+ private:
+  ~nsQtShellService() = default;
+
+  static nsresult RunProcess(const char* aExecutable,
+                             const nsTArray<nsCString>& aArgs,
+                             nsACString* aStdout, int* aExitStatus);
+  static nsresult RunXdgSettings(const nsTArray<nsCString>& aArgs,
+                                 nsACString* aStdout, int* aExitStatus);
+  static bool ResolveDesktopId(nsACString& aDesktopId);
+
+  bool checkDefault(const char* const* aProtocols, unsigned int aLength);
+  nsresult MakeDefault(const char* const* aProtocols,
+                       unsigned int aProtocolsLength, const char* aMimeType,
+                       const char* aExtensions);
+  bool DesktopIdMatchesHandler(const nsACString& aHandlerId) const;
+
+  bool mCheckedThisSession = false;
+  nsCString mDesktopId;
+};
+
+#endif  // COMM_MAIL_COMPONENTS_SHELL_NSQTSHELLSERVICE_H_
